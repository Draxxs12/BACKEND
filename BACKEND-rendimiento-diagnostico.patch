From 5f358f1c1a28d8099a8b0a97e2cda391b550506c Mon Sep 17 00:00:00 2001
From: Pruebas Sprint 4 <pruebas@local>
Date: Wed, 11 Nov 2026 21:35:29 +0000
Subject: [PATCH] ci(rendimiento): tiempo limite en la espera del backend y
 diagnostico de arranque

- curl con -m 5 y limite de 8 min en el paso: un backend colgado ya no bloquea el job.
- Detecta si el proceso Java termino y muestra backend.log.
- Imprime el codigo HTTP de cada intento y el log cada 10 intentos.
---
 .github/workflows/rendimiento.yml | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/rendimiento.yml b/.github/workflows/rendimiento.yml
index 022f6fc..18fa4c1 100644
--- a/.github/workflows/rendimiento.yml
+++ b/.github/workflows/rendimiento.yml
@@ -43,17 +43,29 @@ jobs:
           echo "::add-mask::$TOKEN"
           echo "TOKEN=$TOKEN" >> "$GITHUB_ENV"
       - name: Levantar el backend
+        timeout-minutes: 8        # sin este límite, un backend colgado bloquea el job hasta los 60 min
         run: |
           chmod +x mvnw
           ./mvnw -B -DskipTests package
           nohup java -jar target/*.jar > backend.log 2>&1 &
+          APP_PID=$!
+          echo "Esperando a que el backend quede listo (PID $APP_PID)..."
           # SecurityConfig exige autenticación también en /actuator, por eso la espera usa el token.
-          for i in $(seq 1 100); do
-            CODIGO=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" http://localhost:8080/actuator/health/readiness || true)
+          for i in $(seq 1 60); do
+            if ! kill -0 "$APP_PID" 2>/dev/null; then
+              echo "El proceso Java terminó antes de quedar listo. Últimas líneas de backend.log:"
+              tail -80 backend.log; exit 1
+            fi
+            CODIGO=$(curl -s -m 5 -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" http://localhost:8080/actuator/health/readiness || true)
+            echo "intento $i: HTTP ${CODIGO:-sin respuesta}"
             [ "$CODIGO" = "200" ] && break
+            if [ $((i % 10)) -eq 0 ]; then echo "--- backend.log (últimas 15 líneas)"; tail -15 backend.log; fi
             sleep 3
           done
-          if [ "$CODIGO" != "200" ]; then echo "El backend no quedó listo (último código: $CODIGO)"; tail -50 backend.log; exit 1; fi
+          if [ "$CODIGO" != "200" ]; then
+            echo "El backend no quedó listo (último código: ${CODIGO:-sin respuesta}). Últimas líneas de backend.log:"
+            tail -80 backend.log; exit 1
+          fi
       - name: Preparar el producto de prueba (stock alto para no agotarlo durante la carga)
         env:
           MYSQL_PWD: pruebas
