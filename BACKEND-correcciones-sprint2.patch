diff --git a/src/main/java/com/ferreteria/v1/controllers/CategoriaController.java b/src/main/java/com/ferreteria/v1/controllers/CategoriaController.java
index 0fed96d..c5757d8 100644
--- a/src/main/java/com/ferreteria/v1/controllers/CategoriaController.java
+++ b/src/main/java/com/ferreteria/v1/controllers/CategoriaController.java
@@ -1,5 +1,6 @@
 package com.ferreteria.v1.controllers;
 
+import com.ferreteria.v1.exceptions.Validador;
 import com.ferreteria.v1.models.Categoria;
 import com.ferreteria.v1.repositories.CategoriaRepository;
 import com.ferreteria.v1.services.UsuarioActualService;
@@ -32,12 +33,14 @@ public class CategoriaController {
 
     @PostMapping
     public Categoria crear(@RequestBody Categoria categoria) {
+        Validador.obligatorio(categoria.getNombre(), "nombre de la categoría");
         categoria.setRegistradoPor(usuarioActual.nombreActual());
         return categoriaRepository.save(categoria);
     }
 
     @PutMapping("/{id}")
     public ResponseEntity<Categoria> actualizar(@PathVariable Integer id, @RequestBody Categoria categoria) {
+        Validador.obligatorio(categoria.getNombre(), "nombre de la categoría");
         categoria.setId(id);
         categoria.setRegistradoPor(usuarioActual.nombreActual());
         return ResponseEntity.ok(categoriaRepository.save(categoria));
diff --git a/src/main/java/com/ferreteria/v1/exceptions/Validador.java b/src/main/java/com/ferreteria/v1/exceptions/Validador.java
index 791a004..d6af5e1 100644
--- a/src/main/java/com/ferreteria/v1/exceptions/Validador.java
+++ b/src/main/java/com/ferreteria/v1/exceptions/Validador.java
@@ -32,10 +32,24 @@ public final class Validador {
         }
     }
 
-    /** El RUC, si viene, debe ser solo dígitos y máximo 20 caracteres. */
+    /** El RUC, si viene, debe tener exactamente 11 dígitos numéricos (RUC peruano). */
     public static void ruc(String ruc) {
-        if (ruc != null && !ruc.isBlank() && !ruc.matches("\\d{1,20}")) {
-            throw new ValidacionException("El RUC debe contener solo números y un máximo de 20 dígitos.");
+        if (ruc != null && !ruc.isBlank() && !ruc.matches("\\d{11}")) {
+            throw new ValidacionException("El RUC debe tener exactamente 11 dígitos numéricos.");
+        }
+    }
+
+    /** Texto obligatorio: no puede ser nulo ni estar en blanco. */
+    public static void obligatorio(String valor, String campo) {
+        if (valor == null || valor.isBlank()) {
+            throw new ValidacionException("El " + campo + " es obligatorio.");
+        }
+    }
+
+    /** La cantidad debe ser un número mayor que 0. */
+    public static void cantidadPositiva(Integer cantidad, String campo) {
+        if (cantidad == null || cantidad <= 0) {
+            throw new ValidacionException("La " + campo + " debe ser mayor que 0.");
         }
     }
 
diff --git a/src/main/java/com/ferreteria/v1/services/CompraService.java b/src/main/java/com/ferreteria/v1/services/CompraService.java
index 5be1f48..c396293 100644
