+};
+
+export default function () {
+  const r = http.post(`${BASE_URL}/api/ventas`, ventaDeUnaUnidad(), { ...cabeceras(), tags: { endpoint: 'venta' } });
+  check(r, { 'venta 200': (x) => x.status === 200 });
+}
