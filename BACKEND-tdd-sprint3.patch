 2 files changed, 52 insertions(+)

diff --git a/src/main/java/com/ferreteria/v1/credito/CuentaPorCobrar.java b/src/main/java/com/ferreteria/v1/credito/CuentaPorCobrar.java
index 8859cf1..2e7a33b 100644
--- a/src/main/java/com/ferreteria/v1/credito/CuentaPorCobrar.java
+++ b/src/main/java/com/ferreteria/v1/credito/CuentaPorCobrar.java
@@ -2,6 +2,8 @@ package com.ferreteria.v1.credito;
 
 import java.math.BigDecimal;
 
+import com.ferreteria.v1.exceptions.ValidacionException;
+
 public class CuentaPorCobrar {
 
     private BigDecimal saldo;
@@ -12,7 +14,16 @@ public class CuentaPorCobrar {
     }
 
     public void aplicarPago(BigDecimal monto) {
+        if (monto == null || monto.signum() <= 0) {
+            throw new ValidacionException("El monto del pago debe ser mayor que 0.");
+        }
+        if (monto.compareTo(saldo) > 0) {
+            throw new ValidacionException("El pago no puede ser mayor que el saldo pendiente.");
+        }
         saldo = saldo.subtract(monto);
+        if (saldo.compareTo(BigDecimal.ZERO) == 0) {
+            estado = EstadoCuenta.PAGADA;
+        }
     }
 
