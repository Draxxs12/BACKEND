 @Service
@@ -21,6 +25,8 @@ public class CompraService {
 
     @Autowired private ProductoRepository      productoRepository;
 
+    @Autowired private InventarioRepository    inventarioRepository;
+
     public List<Compra> listarTodos() {
         return compraRepository.findAll();
     }
@@ -33,6 +39,18 @@ public class CompraService {
     @Transactional
     public Compra guardar(Compra compra) {
 
+        // Validaciones de negocio (antes de tocar la base)
+        if (compra.getProveedor() == null) {
+            throw new ValidacionException("La compra debe tener un proveedor.");
+        }
+        if (compra.getDetalles() == null || compra.getDetalles().isEmpty()) {
+            throw new ValidacionException("La compra debe tener al menos un producto.");
+        }
+        for (DetalleCompra d : compra.getDetalles()) {
+            Validador.cantidadPositiva(d.getCantidad(), "cantidad del producto");
+            Validador.noNegativo(d.getPrecioUnitario(), "precio de compra");
+        }
+
         boolean esNueva = (compra.getId() == null);
 
         Estado estadoAnterior = null;
@@ -77,8 +95,19 @@ public class CompraService {
                                 .findById(d.getProducto().getId())
                                 .orElse(null);
                 if (p != null) {
-                    p.setStock(p.getStock() + d.getCantidad());
+                    int stockAntes = p.getStock();
+                    p.setStock(stockAntes + d.getCantidad());
                     productoRepository.save(p);
+
+                    Inventario mov = new Inventario();
+                    mov.setProducto(p);
+                    mov.setUsuario(guardada.getUsuario());
+                    mov.setTipo(Inventario.TipoMovimiento.Entrada);
+                    mov.setCantidad(d.getCantidad());
+                    mov.setStockAntes(stockAntes);
+                    mov.setStockDespues(stockAntes + d.getCantidad());
+                    mov.setMotivo("Compra " + guardada.getNumeroOrden());
+                    inventarioRepository.save(mov);
                 }
             }
         }
diff --git a/src/main/java/com/ferreteria/v1/services/ProveedorService.java b/src/main/java/com/ferreteria/v1/services/ProveedorService.java
index 00ec272..f755746 100644
--- a/src/main/java/com/ferreteria/v1/services/ProveedorService.java
+++ b/src/main/java/com/ferreteria/v1/services/ProveedorService.java
@@ -18,8 +18,11 @@ public class ProveedorService {
     @Autowired
     private UsuarioActualService usuarioActual;
 
+    /** Solo los proveedores activos: los inactivados se conservan en la base pero no se listan. */
     public List<Proveedor> listarTodos() {
-        return proveedorRepository.findAll();
+        return proveedorRepository.findAll().stream()
+                .filter(p -> p.getActivo() == null || p.getActivo())
+                .toList();
     }
 
     public Proveedor buscarPorId(Integer id) {
@@ -31,13 +34,19 @@ public class ProveedorService {
     }
 
     public Proveedor guardar(Proveedor proveedor) {
+        Validador.obligatorio(proveedor.getEmpresa(), "nombre de la empresa");
         Validador.ruc(proveedor.getRuc());
         Validador.email(proveedor.getEmail());
         proveedor.setRegistradoPor(usuarioActual.nombreActual());
         return proveedorRepository.save(proveedor);
     }
 
+    /** Inactiva al proveedor en lugar de borrarlo, para conservar sus compras. */
     public void eliminar(Integer id) {
-        proveedorRepository.deleteById(id);
+        Proveedor p = proveedorRepository.findById(id).orElse(null);
+        if (p != null) {
+            p.setActivo(false);
+            proveedorRepository.save(p);
+        }
     }
 }
