+/** H0005 a H0008 (usuarios, Sprint 1): CP-215 a CP-225. */
+@ExtendWith(MockitoExtension.class)
+@MockitoSettings(strictness = Strictness.LENIENT)
+class UsuarioServiceTest {
+
+    @Mock UsuarioRepository usuarioRepository;
