+name: Calidad backend
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+
+jobs:
+  pruebas:
+    runs-on: ubuntu-latest
+    # V1ApplicationTests y SecurityConfigAuthorizationTest levantan el contexto de Spring (necesita MySQL).
+    services:
+      mysql:
+        image: mysql:8.0
+        env: { MYSQL_ROOT_PASSWORD: pruebas, MYSQL_DATABASE: tienda_db }
+        ports: ['3306:3306']
+        options: >-
+          --health-cmd="mysqladmin ping -h 127.0.0.1" --health-interval=10s --health-timeout=5s --health-retries=10
+    env:
+      DB_URL: jdbc:mysql://127.0.0.1:3306/tienda_db?useSSL=false&allowPublicKeyRetrieval=true
+      DB_USER: root
+      DB_PASS: pruebas
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with: { distribution: temurin, java-version: '17', cache: maven }
+      - name: Permiso de ejecución del wrapper (mvnw está versionado sin ese permiso)
+        run: chmod +x mvnw
+      - name: Pruebas y cobertura (JaCoCo)
+        run: ./mvnw -B verify
+      - name: Análisis estático (SpotBugs + FindSecBugs)
+        run: ./mvnw -B spotbugs:check
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: cobertura-jacoco
+          path: target/site/jacoco/**
+
+  secretos:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with: { fetch-depth: 0 }
+      - uses: gitleaks/gitleaks-action@v2
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
diff --git a/.github/workflows/rendimiento.yml b/.github/workflows/rendimiento.yml
new file mode 100644
index 0000000..022f6fc
--- /dev/null
+++ b/.github/workflows/rendimiento.yml
@@ -0,0 +1,82 @@
+name: Rendimiento
+
+on:
+  pull_request:                 # humo en cada PR
+  schedule:
+    - cron: '0 6 * * *'         # carga nocturna (01:00 hora de Lima)
+  workflow_dispatch:            # estrés y picos, solo bajo demanda
+    inputs:
+      escenario:
+        description: 'Escenario a ejecutar'
+        required: true
+        default: carga
+        type: choice
+        options: [humo, carga, pico, estres]
+
+jobs:
+  rendimiento:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60         # la resistencia de 8 h NO va aquí: se ejecuta en una máquina dedicada
+    services:
+      mysql:
+        image: mysql:8.0
+        env: { MYSQL_ROOT_PASSWORD: pruebas, MYSQL_DATABASE: tienda_db }
+        ports: ['3306:3306']
+        options: >-
+          --health-cmd="mysqladmin ping -h 127.0.0.1" --health-interval=10s --health-timeout=5s --health-retries=10
+    env:
+      DB_URL: jdbc:mysql://127.0.0.1:3306/tienda_db?useSSL=false&allowPublicKeyRetrieval=true
+      DB_USER: root
+      DB_PASS: pruebas
+      # Secretos de CI (ver k6/README.md). La clave es solo para pruebas, nunca la de producción.
+      JWT_SECRET: ${{ secrets.JWT_SECRET_PRUEBAS }}
+      EMAIL: ${{ secrets.EMAIL_ADMIN_PRUEBAS }}
+      # Habilita /actuator/health/readiness, que pasa a 200 cuando DataInitializer ya terminó de cargar datos.
+      MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED: 'true'
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with: { distribution: temurin, java-version: '17', cache: maven }
+      - name: Token de administrador para las pruebas (sin código MFA)
+        run: |
+          TOKEN=$(python3 k6/generar_token.py)
+          echo "::add-mask::$TOKEN"
+          echo "TOKEN=$TOKEN" >> "$GITHUB_ENV"
+      - name: Levantar el backend
+        run: |
+          chmod +x mvnw
+          ./mvnw -B -DskipTests package
+          nohup java -jar target/*.jar > backend.log 2>&1 &
+          # SecurityConfig exige autenticación también en /actuator, por eso la espera usa el token.
+          for i in $(seq 1 100); do
+            CODIGO=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" http://localhost:8080/actuator/health/readiness || true)
+            [ "$CODIGO" = "200" ] && break
+            sleep 3
+          done
+          if [ "$CODIGO" != "200" ]; then echo "El backend no quedó listo (último código: $CODIGO)"; tail -50 backend.log; exit 1; fi
+      - name: Preparar el producto de prueba (stock alto para no agotarlo durante la carga)
+        env:
+          MYSQL_PWD: pruebas
+        run: mysql --protocol=TCP -h127.0.0.1 -uroot tienda_db -e "UPDATE productos SET stock = 1000000 WHERE id = 1;"
+      - uses: grafana/setup-k6-action@v1
+      - name: Ejecutar escenario k6
+        env:
+          PRODUCTO_ID: '1'
+          CLIENTE_ID: '1'
+          USUARIO_ID: '1'
+        run: |
+          ESC="${{ github.event.inputs.escenario || (github.event_name == 'schedule' && 'carga' || 'humo') }}"
+          case "$ESC" in
+            humo)   FILE=k6/humo.js ;;
+            carga)  FILE=k6/busqueda_productos.js ;;
+            pico)   FILE=k6/venta_pico.js ;;
+            estres) FILE=k6/estres.js ;;
+          esac
+          k6 run --summary-export=resumen-k6.json "$FILE"
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: reportes-rendimiento
+          path: |
+            resumen-k6.json
+            backend.log
